# The single authoritative dependency pin set. Sourced by
# scripts/download-libs.sh and included by the Makefile - change
# versions and checksums here and nowhere else.
FLATLAF_VERSION=3.7.2
JSVG_VERSION=2.1.0
JUNIT_VERSION=6.1.3

# SHA-256 of each pinned artifact: both bootstrap scripts verify
# existing and freshly downloaded files against these, so idempotence
# means "the correct pinned artifact is present", never a stale or
# partial file (Sprint 9 Codex review).
FLATLAF_SHA256=917aff3963c88d797d0fd9b9ccbd70f7681c101df9d11c59e2bc7a3a6c0fabf4
FLATLAF_EXTRAS_SHA256=7d03612d5c11d27a4ac714e79b11c73405d07f84a3214fe4ae091daadc8b5166
JSVG_SHA256=a538142d27c57c55066da02a535cc8eee3afd0d37b3daff8eba6344bd0ffc1b6
JUNIT_SHA256=e62b96ac475dbcde8599ea905d088f65d90778f86e259b856a49fa5c4ea256ec
