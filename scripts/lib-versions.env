# The single authoritative dependency pin set. Sourced by
# scripts/download-libs.sh, parsed by scripts/download-libs.ps1, and
# included by the Makefile - change versions here and nowhere else.
FLATLAF_VERSION=3.4.1
JSVG_VERSION=1.7.2
JUNIT_VERSION=1.10.2

# SHA-256 of each pinned artifact: both bootstrap scripts verify
# existing and freshly downloaded files against these, so idempotence
# means "the correct pinned artifact is present", never a stale or
# partial file (Sprint 9 Codex review).
FLATLAF_SHA256=8b4bbd34727f80e74555b2be3d8dcb994434654986c64f4298162247a9d35ffc
FLATLAF_EXTRAS_SHA256=74dad5fa0d952d2c535911d762b0b818048016db08f5f0fe79a7d1cca183051f
JSVG_SHA256=5591409ef245e48004f0524790b7042cd239acc01327326cfd4edfa57f475f99
JUNIT_SHA256=a1de557821293ce903c213c694165fff532cf92081bac4238b9e05b35f04f43f
